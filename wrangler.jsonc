{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ctfile-downloader",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "send_metrics": false,

  "kv_namespaces": [
    {
      "binding": "TOKENS_KV",
      "id": "你的_KV_ID"
    }
  ]
}
